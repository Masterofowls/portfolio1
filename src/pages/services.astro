---
import Layout from '../layouts/Layout.astro';
import { Services } from '../components/Services';
import { Button } from '../components/ui/button';
---

<Layout title="Services - Developer Portfolio">
  <main class="flex-1">
    <section class="relative overflow-hidden py-16 md:py-24">
      {/* Hero Section */}
      <div class="container relative z-10">
        <div class="mx-auto max-w-3xl text-center">
          <h1 class="mb-6 bg-gradient-to-r from-foreground to-accent/80 bg-clip-text text-4xl font-bold text-transparent md:text-5xl lg:text-6xl">
            Professional Web Development Services
          </h1>
          <p class="mb-8 text-lg text-muted-foreground md:text-xl">
            From concept to deployment, I help businesses create exceptional digital experiences.
          </p>
          <div class="flex justify-center gap-4">
            <Button variant="gradient" size="lg" asChild>
              <a href="#contact">Get Started</a>
            </Button>
            <Button variant="outline" size="lg" asChild>
              <a href="#services">Learn More</a>
            </Button>
          </div>
        </div>
      </div>

      {/* Background Elements */}
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f1a_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f1a_1px,transparent_1px)] bg-[size:64px_64px]"></div>
        <div class="absolute left-0 top-0 h-[20rem] w-[20rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent opacity-10 blur-[100px]"></div>
        <div class="absolute right-0 top-0 h-[20rem] w-[20rem] translate-x-1/2 -translate-y-1/2 rounded-full bg-primary opacity-10 blur-[100px]"></div>
      </div>
    </section>

    {/* Services Section */}
    <Services client:load />

    {/* Process Section */}
    <section class="py-16 md:py-24">
      <div class="container">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-3xl font-bold md:text-4xl">How I Work</h2>
          <p class="mx-auto max-w-2xl text-muted-foreground">
            A structured approach to delivering high-quality web solutions.
          </p>
        </div>

        <div class="relative">
          {/* Timeline Line */}
          <div class="absolute left-4 top-0 h-full w-px bg-border md:left-1/2"></div>

          {/* Timeline Items */}
          <div class="space-y-12">
            {[
              {
                title: "Discovery",
                description:
                  "Understanding your goals, requirements, and target audience to create a solid foundation for your project.",
                icon: "🎯",
              },
              {
                title: "Planning",
                description:
                  "Creating a detailed roadmap, choosing the right technologies, and establishing project milestones.",
                icon: "📋",
              },
              {
                title: "Design",
                description:
                  "Crafting beautiful, user-friendly interfaces that align with your brand and meet user needs.",
                icon: "🎨",
              },
              {
                title: "Development",
                description:
                  "Building your solution using modern technologies and best practices for optimal performance.",
                icon: "💻",
              },
              {
                title: "Testing",
                description:
                  "Rigorous testing across devices and browsers to ensure a flawless user experience.",
                icon: "🔍",
              },
              {
                title: "Launch",
                description:
                  "Deploying your project and providing ongoing support to ensure long-term success.",
                icon: "🚀",
              },
            ].map((step, index) => (
              <div class="relative pl-10 md:ml-1/2 md:pl-12">
                <div class={`absolute left-0 top-0 flex h-8 w-8 items-center justify-center rounded-full border-2 border-accent bg-background text-xl md:-ml-4 ${index === 0 ? 'animate-bounce' : ''}`}>
                  {step.icon}
                </div>
                <div class="rounded-lg border bg-card p-6">
                  <h3 class="mb-2 text-xl font-semibold">{step.title}</h3>
                  <p class="text-muted-foreground">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CTA Section */}
    <section class="relative overflow-hidden py-16 md:py-24">
      <div class="container relative z-10">
        <div class="rounded-lg border bg-card/50 p-8 backdrop-blur supports-[backdrop-filter]:bg-card/30 md:p-12">
          <div class="mx-auto max-w-3xl text-center">
            <h2 class="mb-4 text-3xl font-bold md:text-4xl">Ready to Start Your Project?</h2>
            <p class="mb-8 text-muted-foreground">
              Let's work together to create something amazing. Get in touch to discuss your project.
            </p>
            <Button variant="gradient" size="lg" asChild>
              <a href="#contact">Get in Touch</a>
            </Button>
          </div>
        </div>
      </div>

      {/* Background Elements */}
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f1a_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f1a_1px,transparent_1px)] bg-[size:64px_64px]"></div>
        <div class="absolute right-0 bottom-0 h-[20rem] w-[20rem] translate-x-1/2 translate-y-1/2 rounded-full bg-accent opacity-10 blur-[100px]"></div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .container {
    @apply mx-auto max-w-7xl px-4 sm:px-6 lg:px-8;
  }
</style>
